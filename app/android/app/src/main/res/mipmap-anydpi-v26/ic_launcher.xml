<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ masks the icon to whatever shape the launcher uses. Without
     an adaptive icon a legacy PNG gets shrunk and letterboxed onto a white
     plate, which would put the lime mark in a white box on most phones. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
