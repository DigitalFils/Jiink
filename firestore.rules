rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile. Never exposes stripeAccountId to anyone else —
    // public seller info (name, city) is denormalized onto their listings
    // instead of read from here.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The public feed. Anyone signed in can read every listing. A seller
    // can create and edit their own, but never flip `status` themselves —
    // only the payment webhook (Admin SDK, bypasses these rules) marks a
    // listing sold.
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'live';
      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.status == resource.data.status;
      // Watching is the only signal a non-owner can leave on a listing —
      // no likes, no comments — and it's scoped so tightly that touching
      // it can never be a backdoor to editing price/status/anything else:
      // the update is only allowed when watcherIds is the *sole* field
      // whose value actually changed.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watcherIds']);
      allow delete: if false;
    }

    // One thread per (listing, buyer) pair, so a listing with several
    // interested buyers gets a separate conversation each.
    match /chatThreads/{threadId} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    // Orders only ever come from the Stripe webhook (Admin SDK). Buyer and
    // seller can read their own.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow write: if false;
    }
  }
}
