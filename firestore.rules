rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile. Never exposes stripeAccountId to anyone else —
    // public seller info (name, city) is denormalized onto their listings
    // instead of read from here.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The public feed. Anyone signed in can read every listing. A seller
    // can create and edit their own, but never flip `status` themselves —
    // only the payment webhook (Admin SDK, bypasses these rules) marks a
    // listing sold.
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'live';
      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.status == resource.data.status;
      // Watching is the only signal a non-owner can leave on a listing —
      // no likes, no comments — and it's scoped so tightly that touching
      // it can never be a backdoor to editing price/status/anything else:
      // the update is only allowed when watcherIds is the *sole* field
      // whose value actually changed.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watcherIds']);
      allow delete: if false;
    }

    // One thread per (listing, buyer) pair, so a listing with several
    // interested buyers gets a separate conversation each.
    match /chatThreads/{threadId} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    // Orders only ever come from the Stripe webhook (Admin SDK). Buyer and
    // seller can read their own.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow write: if false;
    }

    // A buyer's rating of a seller after a completed sale. Doc id is the
    // listingId — a listing sells at most once, so a second create attempt
    // at the same id is classified as an update, which is denied below,
    // making a review a one-shot, immutable thing per sale.
    //
    // The client-supplied orderId is checked against the real orders
    // collection (webhook-only, never client-written) rather than trusting
    // anything else in the request: this is what actually proves the
    // reviewer paid for this exact listing, as this exact seller's buyer,
    // rather than fabricating a 5-star review for a stranger's item.
    match /reviews/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.auth.uid == request.resource.data.buyerId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.listingId == listingId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerId == request.resource.data.sellerId;
      allow update, delete: if false;
    }

    // A buyer's offer on a listing. Doc id is listingId_buyerId — same
    // composite-key pattern as chatThreads — so a buyer gets exactly one
    // active offer per listing; a second create attempt at the same id is
    // classified as an update and falls through to the rule below, which
    // only the seller (not the buyer) can use.
    match /offers/{offerId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.buyerId
        && offerId == request.resource.data.listingId + '_' + request.resource.data.buyerId
        && request.resource.data.status == 'pending'
        && request.resource.data.offerCents is int
        && request.resource.data.offerCents > 0
        && request.resource.data.offerCents
             < get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.priceCents
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'live'
        && request.resource.data.sellerId
             == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId;
      // Only the seller can respond, only while it's still pending, and only
      // by flipping status — the buyer can never edit their own offer
      // (no raising it after the fact, no self-approving a discount by
      // writing "accepted" themselves: that's gated on resource.data.sellerId,
      // which is the seller who already owned this offer, not whoever calls).
      allow update: if request.auth != null
        && request.auth.uid == resource.data.sellerId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if false;
    }
  }
}
