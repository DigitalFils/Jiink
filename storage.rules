rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // One photo per listing, named by the listing's own id. Anyone signed
    // in can view it (it's a public marketplace feed); only the seller who
    // owns that listing id can upload or replace it.
    match /listingPhotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
